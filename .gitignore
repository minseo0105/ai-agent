# Keep deployable Streamlit configuration in Git, but never commit credentials.
.streamlit/secrets.toml

# Local runtime data and Python build artifacts.
realestate_monitor.db
# 관리자 설정(구성원·접속코드 해시)과 토큰 서명 키
data/admin/
.venv/
venv/
.rembg/
__pycache__/
*.py[cod]
*.bak

# Retired scripts, intermediate pipeline outputs and backups (kept locally only).
_archive/

# Next.js frontend build output and dependencies.
web/node_modules/
web/.next/
web/.env.local
*.tsbuildinfo

# Golf DB backups and local run logs (the DB itself and review reports are versioned).
data/golf/backups/
data/golf/enrichment_review/logs/

# Golf runtime cache / live reports; reviewed seed data is versioned separately.
data/golf/runtime/

# Generated exports from local runs.
*.pdf
test.py
dart_test.py
law_test.py
web/out/

# Isolated ZIP REST test dependencies and credential-free recovery journals
reports/zipon-rest-venv/
reports/zipon-rest-tests/
reports/zipon-source-inspection/
reports/zipon-sql-review/

# Actual DB apply/reconciliation journals stay local (including failed atomic saves).
