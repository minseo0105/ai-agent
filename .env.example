# 복사해서 사용: cp .env.example .env.docker  (그다음 값을 채운다)
# .env.docker는 Git에 올리지 않는다. 쓰지 않는 기능의 키는 비워 두면 그 기능만 꺼진다.
# 코드는 환경변수 -> .streamlit/secrets.toml 순으로 읽는다 (services/config.py). 컨테이너에는 secrets.toml이 없다.

# ---- 서버 동작 ----
# 화면을 다른 주소(Vercel 등)에서 따로 띄울 때만 필요. 한 주소로 서비스하면 비워도 된다.
FRONTEND_ORIGINS=
AILAB_LOG_LEVEL=INFO
# 배경 제거 모델 (기본 u2net)
REMBG_MODEL=
# 배포 판 식별용(선택). 비우면 자동 감지
AILAB_BUILD_ID=

# ---- 접근 관리 (필수 권장) ----
ADMIN_PASSWORD=
# 토큰 서명 키. 비우면 Supabase에 자동 생성/보관
ACCESS_SECRET=
# 관리자 설정 저장소. 비우면 컨테이너 안 data/admin(볼륨)에 저장
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI / 검색 ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# ---- 공공데이터 / 지도 ----
DART_API_KEY=
LAW_OC=
PUBLIC_DATA_API_KEY=
DATA_GO_KR_SERVICE_KEY=
VWORLD_API_KEY=
VWORLD_DOMAIN=
KAKAO_REST_API_KEY=
NAVER_API_KEY=
# 네이버 지도(필수): 네이버 클라우드 콘솔 Maps Application의 Client ID / Client Secret.
#   지도 SDK(services/map_providers.py)는 NAVER_MAP_CLIENT_ID만 읽는다. 비어 있으면 네이버 지도 대신
#   기본 지도(OSM)로 뜬다. 아래 NCP_KEY_ID만 채워도 /api/ready의 naver 점검은 ok가 나오니 주의.
#   CLIENT_SECRET은 서버 지오코딩(ZIP:ON 개발사업) 전용이며 브라우저로 내려가지 않는다.
#   이 Application의 Web 서비스 URL에 서비스 주소(예: https://도메인)가 등록돼 있어야 지도 인증이 통과한다.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 골프 주소 검색·길찾기(services/golf_service.py)와 /api/ready 점검용 (지도 SDK는 이 값을 쓰지 않음)
NAVER_MAP_NCP_KEY=
NAVER_MAP_NCP_KEY_ID=
# 비우면 ncpKeyId(신 콘솔), 실패 시 ncpClientId(구 콘솔)로 자동 재시도
NAVER_MAP_KEY_PARAM=
# 안내용: 지도 설정 응답에 "이 주소를 콘솔에 등록하세요"로 표시만 한다. 지도 인증에는 쓰이지 않음
# (네이버는 브라우저의 실제 페이지 주소를 콘솔 등록 목록과 비교). https:// 포함, 끝 / 없이. 비우면 기존 HF 주소
NAVER_WEB_SERVICE_URL=

# ---- ZIP:ON / 분석 (Supabase 별도 프로젝트) ----
ZIPON_SUPABASE_URL=
ZIPON_SUPABASE_SERVICE_ROLE_KEY=
ANALYTICS_SUPABASE_URL=
ANALYTICS_SUPABASE_SERVICE_ROLE_KEY=

# ---- compose 전용: 컨테이너가 아니라 compose가 읽는다 -> 이 파일이 아니라 `.env`(없으면 새로 만듦)에 둔다 ----
# Caddy가 받을 주소. 도메인이 없으면 비워 둔다(HTTP :80, IP로 접속).
# 도메인을 연결하면 SITE_ADDRESS=ailab.example.com 으로 적고 `docker compose up -d` -> HTTPS 인증서 자동 발급
# (도메인 A레코드가 VM 공인 IP를 가리키고 80/443이 열려 있어야 함)
SITE_ADDRESS=
